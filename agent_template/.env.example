# ============================
# LLM (OpenAI-compatible endpoint)
# ============================
LLM_API_KEY=your-api-key
LLM_BASE_URL=http://litellm.infra-dev.dev.tsmc.com
LLM_MODEL=DEV/AI-CODING
# LLM_TEMPERATURE=0.0

# ============================
# Observability (OpenTelemetry)
# ============================
OTEL_ENABLED=false
OTEL_ENDPOINT=http://your-otel-endpoint
# OTEL_SAMPLING_RATIO=1.0
# SERVICE_NAME=agent_template
# CID=
# AGENT_VERSION=

# ============================
# Auth
# ============================
AUTH_ENDPOINT=http://your-auth-endpoint
