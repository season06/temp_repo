apiVersion: apps/v1
kind: Deployment
metadata:
  name: myapp
  namespace: {{ dev.namespace }}
spec:
  replicas: {{ dev.replicas }}
  selector:
    matchLabels:
      app: myapp
  template:
    metadata:
      labels:
        app: myapp
    spec:
      containers:
      - name: myapp
        image: myapp:latest
        ports:
        - containerPort: 80
        